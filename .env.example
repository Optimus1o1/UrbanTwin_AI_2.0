# =====================================================================
# UrbanTwin AI - Environment Configuration Template
# Copy this file to .env and configure values before deployment
# =====================================================================

# Security Keys (CHANGE FOR PRODUCTION!)
SECRET_KEY=urbantwin-super-secret-key-change-in-production-2026-secure
ANPR_SALT=urbantwin_anpr_salt_privacy_protection_9921

# Server Settings
HOST=127.0.0.1
PORT=8000
RELOAD=true
ENVIRONMENT=production

# CORS Origins (Comma-separated or list in Python config)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SIMULATION=20/minute
RATE_LIMIT_AUTH=10/minute

# AI Engine & Vision API Keys (Optional)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
